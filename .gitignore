# =============================================================================
# fpga_src .gitignore
# Only ignore things that can be regenerated.  The minimal SoC IP
# (ip/riscv_soc0/*.v, settings.json, RAM init images) and the firmware hex are
# tracked so a clean clone can build without the IP Manager GUI.
# =============================================================================

# --- Efinity build outputs ---
/outflow/
/work_syn/
/work_pnr/
/work_dbg/
*.proj_state.ini
*.lbf
*.primplace

# --- RISC-V firmware build outputs (sources kept) ---
**/software/standalone/**/build/
**/software/standalone/**/obj_files/

# --- IP Manager regenerates these vendor deliverables; keep only the core ---
/ip/*_outflow/
/ip/*/*_devkit/
/ip/*/Testbench/
/ip/*/source/hardware/netlist/
/ip/riscv_soc0/riscv_soc0_tmpl.v
/ip/riscv_soc0/riscv_soc0_tmpl.vhd

# --- misc ---
__pycache__/
*.pyc
*.o
*.a
*.d
*.wlf
vsim.wlf

# --- editor / temporary work dirs / backups ---
.ccls-cache/
.codegraph/
/work_pm/
/work_pt/
*.bak_*
