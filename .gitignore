# =============================================================================
# fpga_src .gitignore
# Only ignore things that can be regenerated.  The SoC IP is generated from
# config/riscv_soc0_settings.json; the firmware hex stays tracked.
# =============================================================================

# --- Efinity build outputs ---
/outflow/
/work_syn/
/work_pnr/
/work_dbg/
*.proj_state.ini
*.lbf
*.primplace

# --- RISC-V firmware build outputs (sources kept) ---
**/software/standalone/**/build/
**/software/standalone/**/obj_files/

# --- generated SoC IP (settings source: config/riscv_soc0_settings.json) ---
/ip/

# --- misc ---
__pycache__/
*.pyc
*.o
*.a
*.d
*.wlf
vsim.wlf

# --- editor / temporary work dirs / backups ---
.ccls-cache/
.codegraph/
/work_pm/
/work_pt/
*.bak_*
