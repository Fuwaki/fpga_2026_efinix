# Verilator simulations for the video subsystem.
#   make -C sim             lint, then every test
#   make -C sim tb_ring     one test (sim/tb/tb_ring.sv, top module tb_ring)
#   make -C sim lint        lint the synthesisable library
#   SEED=7 make -C sim ...  other random seed
ROOT   := $(abspath ..)
OBJ    ?= $(ROOT)/sim/obj
SEED   ?= 1
VFLAGS := --binary --timing --assert -j 0 -Wall -Wno-fatal \
          -Wno-DECLFILENAME -Wno-UNUSEDPARAM -Wno-UNUSEDSIGNAL -Wno-PINCONNECTEMPTY -Wno-SYNCASYNCNET \
          --x-assign unique --x-initial unique -DVID_SVA --timescale 1ns/1ps

RTL := $(addprefix $(ROOT)/rtl/vid/, \
         common/vid_pkg.sv common/vstream_if.sv common/vpush_if.sv common/axi4_if.sv \
         common/mul_nodsp.sv common/fifo_sync_core.sv common/fifo_async_core.sv \
         common/vstream_fifo.sv common/push2stream.sv \
         dma/ring_if.sv dma/frame_ring_core.sv dma/frame_ring.sv \
         dma/axi_arb.sv dma/vdma_wr.sv dma/vdma_rd.sv \
         dbg/vid_testgen.sv dbg/vid_testchk.sv dbg/vid_patgen.sv \
         isp/csi_capture.sv isp/line_release.sv isp/isp_stats.sv isp/isp_blc_wb.sv \
         isp/isp_demosaic.sv isp/isp_gamma.sv isp/isp_sat.sv isp/isp_dither565.sv isp/isp_top.sv \
         proc/proc_stub.sv proc/proc_engine.sv \
         disp/layer_unpack.sv disp/osd_font.sv disp/compositor.sv vid_subsystem.sv) \
       $(ROOT)/rtl/vid/disp/raster_gen.sv
SVA := $(ROOT)/rtl/vid/common/sva/vstream_sva.sv \
       $(ROOT)/rtl/vid/common/sva/axi4_sva.sv \
       $(ROOT)/sim/bind/vid_bind.sv
MODELS := $(ROOT)/sim/models/vstream_bfm.sv \
          $(ROOT)/sim/models/axi_mem_model.sv

TESTS := tb_st_accel tb_st_requant tb_st_dma_rep tb_st_io tb_st_add tb_st_dw tb_st_pw tb_st_prepost tb_st_engine tb_st_film tb_st_norm tb_fifo tb_ring tb_ring_tight tb_dma tb_vidsub tb_vidsub_badid \
         tb_disp tb_proc tb_disp_split tb_disp_split0 tb_osd tb_isp tb_isp_bypass tb_isp_pat sva_neg

.PHONY: all lint $(TESTS)
all: lint $(TESTS)

lint:
	verilator --lint-only -Wall -Wno-DECLFILENAME -Wno-UNUSEDPARAM \
	  --top-module sv_probe_top $(RTL) $(ST_ENG) $(ROOT)/tools/sv_probe/sv_probe_top.sv
	@echo "PASS lint"

# build <obj-name> <tb-file> <top> <extra verilator flags>
# A warning located in synthesisable code (rtl/vid) fails the build.
define build
	@mkdir -p $(OBJ)/$(1)
	verilator $(VFLAGS) --top-module $(3) $(4) -Mdir $(OBJ)/$(1) \
	  $(RTL) $(EXTRA_$(1)) $(SVA) $(MODELS) $(ROOT)/sim/tb/$(2).sv > $(OBJ)/$(1)/build.log 2>&1 \
	  || { tail -30 $(OBJ)/$(1)/build.log; exit 1; }
	@if grep -E '^%Warning-[A-Z]+: $(ROOT)/rtl/(vid|st_accel_new)/' $(OBJ)/$(1)/build.log \
	     | grep -v '/sva/'; then \
	  echo "FAIL $(1): warnings in synthesisable RTL (see $(OBJ)/$(1)/build.log)"; exit 1; fi
endef

ST := $(ROOT)/rtl/st_accel_new/dma/tile_dma_rd.sv $(ROOT)/rtl/st_accel_new/dma/tile_dma_wr.sv \
      $(ROOT)/rtl/st_accel_new/st_accel_wrapper.sv

# Block engine primitives; st_net_pkg.sv is generated by tools/st_gen_params.py
# and committed under rtl/st_accel_new/gen/.
ST_ENG := $(ROOT)/rtl/st_accel_new/gen/guided/st_net_pkg.sv \
          $(ROOT)/rtl/st_accel_new/engine/st_requant.sv \
          $(ROOT)/rtl/st_accel_new/engine/st_unpack.sv \
          $(ROOT)/rtl/st_accel_new/engine/st_pack.sv \
          $(ROOT)/rtl/st_accel_new/engine/st_add.sv \
          $(ROOT)/rtl/st_accel_new/engine/st_dw.sv \
          $(ROOT)/rtl/st_accel_new/engine/st_dw_rom.sv \
          $(ROOT)/rtl/st_accel_new/engine/st_rq_rom.sv \
          $(ROOT)/rtl/st_accel_new/engine/st_line_ram.sv \
          $(ROOT)/rtl/st_accel_new/engine/st_mac8x16.sv \
          $(ROOT)/rtl/st_accel_new/engine/st_pw_rom.sv \
          $(ROOT)/rtl/st_accel_new/engine/st_pw.sv \
          $(ROOT)/rtl/st_accel_new/engine/st_pre.sv \
          $(ROOT)/rtl/st_accel_new/engine/st_post.sv \
          $(ROOT)/rtl/st_accel_new/engine/st_film.sv \
          $(ROOT)/rtl/st_accel_new/engine/st_norm.sv \
          $(ROOT)/rtl/st_accel_new/engine/st_engine.sv

# ST accelerator as the processing engine (external AXI master + ring ports).
EXTRA_tb_st_accel := $(ST_ENG) $(ST)
tb_st_accel:
	$(call build,$@,$@,$@,)
	cd $(ROOT) && $(OBJ)/$@/V$@ +verilator+seed+$(SEED) +verilator+rand+reset+2

# Requant lane against tools/st_rq_vectors.py: every manifest requant
# parameter and add factor, crafted rounding ties, clamp edges, a random sweep.
EXTRA_tb_st_requant := $(ST_ENG)
tb_st_requant:
	@mkdir -p $(OBJ)/$@
	$(ROOT)/tools/st_rq_vectors.py --out $(OBJ)/$@/vectors.hex
	$(call build,$@,$@,$@,)
	$(OBJ)/$@/V$@ +verilator+seed+$(SEED) +verilator+rand+reset+2 \
	  +VEC=$(OBJ)/$@/vectors.hex

# tile_dma_rd line repeat (the vertical half of the 2x upsample).
EXTRA_tb_st_dma_rep := $(ST)
tb_st_dma_rep:
	$(call build,$@,$@,$@,)
	$(OBJ)/$@/V$@ +verilator+seed+$(SEED) +verilator+rand+reset+2

# DW stage of the block engine against tools/st_dw_vectors.py: every case is
# synthetic and carries its own small ROM images, one shape per net layer
# (80 channels at 160 wide, 16 and 24 at 320, 8 at 640, the 640x8 stem).
# Each case runs twice -- with random input and output gaps, then clean -- and
# the clean number is the stage's cycles per input beat.
ST_DW_CASES := tiny tiny_s2 tiny_w2 syn_g20 syn_g20_s2 syn_g4_s2 syn_g6 \
               syn_g2_w640 im2col bypass
ST_DW_VEC   := $(OBJ)/tb_st_dw/cases
EXTRA_tb_st_dw := $(ST_ENG)

tb_st_dw:
	@mkdir -p $(ST_DW_VEC)
	@for c in $(ST_DW_CASES); do \
	  $(ROOT)/tools/st_dw_vectors.py --case $$c --out $(ST_DW_VEC)/$$c \
	    || exit 1; done
	$(call build,$@,$@,$@,)
	@for c in $(ST_DW_CASES); do \
	  (cd $(ROOT) && $(OBJ)/$@/V$@ +verilator+seed+$(SEED) +verilator+rand+reset+2 \
	    +CASE_DIR=$(ST_DW_VEC)/$$c +CLEAN=0) || exit 1; \
	  (cd $(ROOT) && $(OBJ)/$@/V$@ +verilator+seed+$(SEED) +verilator+rand+reset+2 \
	    +CASE_DIR=$(ST_DW_VEC)/$$c +CLEAN=1) | grep ' (clean)' || exit 1; \
	done

# The PW stage against tools/st_pw_vectors.py: one run per case, each with
# random input gaps (and a few 300-cycle stalls) and 30% output stalls, then
# again with no stalls for the cycles-per-pixel figure.
PW_CASES := c80_80 c80_24 c16_80 c24_40 c40_8 c8_3u w27_8 w27_16 w27_10_40 n24_24
PW_DIR   := $(OBJ)/tb_st_pw
EXTRA_tb_st_pw := $(ST_ENG)
tb_st_pw:
	@mkdir -p $(PW_DIR)
	$(call build,$@,$@,$@,)
	@for c in $(PW_CASES); do \
	  cd $(ROOT) && tools/st_pw_vectors.py --case $$c --out $(PW_DIR)/$$c || exit 1; \
	  cd $(ROOT) && $(PW_DIR)/Vtb_st_pw +verilator+seed+$(SEED) +verilator+rand+reset+2 \
	    +CASE_DIR=$(PW_DIR)/$$c || exit 1; \
	done

# The norm stage (LayerNorm and the FiLM affine) against
# tools/st_norm_vectors.py: the real LN of the guided net, 2000 synthetic
# pixels whose statistics hit the ends of the datapath, and the real FiLM of
# the net with its coefficients written through the port.  Each case runs with
# random gaps and back-pressure, then clean for the cycles/pixel figure.
NORM_CASES := ln ln_syn ln_min film
NORM_DIR   := $(OBJ)/tb_st_norm
EXTRA_tb_st_norm := $(ST_ENG)

tb_st_norm:
	@mkdir -p $(NORM_DIR)
	$(call build,$@,$@,$@,)
	@for c in $(NORM_CASES); do \
	  cd $(ROOT) && tools/st_norm_vectors.py --case $$c --out $(NORM_DIR)/$$c \
	    || exit 1; \
	  cd $(ROOT) && $(NORM_DIR)/Vtb_st_norm +verilator+seed+$(SEED) +verilator+rand+reset+2 \
	    +CASE_DIR=$(NORM_DIR)/$$c || exit 1; \
	done

# Pass 0 (pre, FULL and POOL) and the head pass (post) against
# tools/st_prepost_vectors.py: the guided net's 1280x720 camera frame through
# the golden model's pre(), the network, pool_int() and post().  post43 is the
# same head output through st_post's other replication (REP_X = 4, REP_Y = 3,
# the tiny_dw engine's).  Each case is a whole frame, every input and output
# beat and flag compared; it runs once with random gaps and back-pressure,
# then clean for the cycle count.
PREPOST_CASES := pre_full pre_pool post post43
EXTRA_tb_st_prepost := $(ST_ENG)
tb_st_prepost:
	@mkdir -p $(OBJ)/$@
	$(ROOT)/tools/st_prepost_vectors.py --out $(OBJ)/$@
	$(call build,$@,$@,tb_st_prepost,)
	@for c in $(PREPOST_CASES); do \
	  cd $(ROOT) && $(OBJ)/$@/Vtb_st_prepost +verilator+seed+$(SEED) +verilator+rand+reset+2 \
	    +VEC=$(OBJ)/$@ +CASE=$$c +CLEAN=0 || exit 1; \
	  cd $(ROOT) && $(OBJ)/$@/Vtb_st_prepost +verilator+seed+$(SEED) +verilator+rand+reset+2 \
	    +VEC=$(OBJ)/$@ +CASE=$$c +CLEAN=1 | grep ' (clean)' || exit 1; \
	done

# The FiLM GAP tap and MLP sequencer against tools/st_film_vectors.py: the
# real FiLM pass input (net.ddr[17] of g360/in/cat.png), all codes at +254
# and -254, and a random plane.  Each case is a whole 320x180 plane (576000
# tap beats) plus the 40 coefficient writes.
FILM_CASES := real max min rand
FILM_DIR   := $(OBJ)/tb_st_film
EXTRA_tb_st_film := $(ST_ENG)
tb_st_film:
	@mkdir -p $(FILM_DIR)
	$(call build,$@,$@,$@,)
	@for c in $(FILM_CASES); do \
	  cd $(ROOT) && tools/st_film_vectors.py --case $$c --out $(FILM_DIR)/$$c || exit 1; \
	  cd $(ROOT) && $(FILM_DIR)/Vtb_st_film +verilator+seed+$(SEED) +verilator+rand+reset+2 \
	    +DIR=$(FILM_DIR)/$$c || exit 1; \
	done

# The whole block engine on one frame against tools/st_engine_vectors.py:
# every DDR region and the PROC right half, byte-exact.  ENGINE_PASSES=a..b
# runs a subrange on golden-preloaded DDR (one pass takes 1-3 minutes).
ENGINE_PASSES ?= 0..11
EXTRA_tb_st_engine := $(ROOT)/rtl/st_accel_new/dma/tile_dma_rd.sv \
                      $(ROOT)/rtl/st_accel_new/dma/tile_dma_wr.sv $(ST_ENG)
tb_st_engine:
	@mkdir -p $(OBJ)/$@
	$(ROOT)/tools/st_engine_vectors.py --out $(OBJ)/$@/vec
	$(call build,$@,$@,$@,)
	cd $(ROOT) && $(OBJ)/$@/V$@ +verilator+seed+$(SEED) +verilator+rand+reset+2 \
	  +DIR=$(OBJ)/$@/vec +FIRST=$(firstword $(subst .., ,$(ENGINE_PASSES))) \
	  +LAST=$(lastword $(subst .., ,$(ENGINE_PASSES)))

# st_unpack / st_pack / st_add against tools/st_io_vectors.py (the guided
# net's activations at 640x360; DDR beats from Guided.ddr_image).  One build,
# one run per case.
IO_CASES  := unpack_p10 unpack_p17 unpack_p13_hrep unpack_p1 \
             pack_p2 pack_p16 pack_p10 pack_p17
ADD_CASES := add_res add_h2 add_head
EXTRA_tb_st_io  := $(ST_ENG)
EXTRA_tb_st_add := $(ST_ENG)
$(OBJ)/st_io_vec/stamp: $(ROOT)/tools/st_io_vectors.py $(ROOT)/tools/st_golden.py \
                        $(ROOT)/tools/st_guided.py
	@mkdir -p $(OBJ)/st_io_vec
	$(ROOT)/tools/st_io_vectors.py --out $(OBJ)/st_io_vec
	@touch $@
tb_st_io: $(OBJ)/st_io_vec/stamp
	$(call build,$@,$@,$@,)
	@for t in $(IO_CASES); do \
	  $(OBJ)/$@/V$@ +verilator+seed+$(SEED) +verilator+rand+reset+2 \
	    +DIR=$(OBJ)/st_io_vec/$$t $$(cat $(OBJ)/st_io_vec/$$t/args) || exit 1; done
tb_st_add: $(OBJ)/st_io_vec/stamp
	$(call build,$@,$@,$@,)
	@for t in $(ADD_CASES); do \
	  $(OBJ)/$@/V$@ +verilator+seed+$(SEED) +verilator+rand+reset+2 \
	    +DIR=$(OBJ)/st_io_vec/$$t $$(cat $(OBJ)/st_io_vec/$$t/args) || exit 1; done

tb_fifo tb_ring tb_dma tb_vidsub tb_disp tb_osd:
	$(call build,$@,$@,$@,)
	$(OBJ)/$@/V$@ +verilator+seed+$(SEED) +verilator+rand+reset+2

# Fewer slots than NCONS + 2: drops are legal and the model must agree.
tb_ring_tight:
	$(call build,$@,tb_ring,tb_ring,-GSLOTS=3)
	$(OBJ)/$@/Vtb_ring +verilator+seed+$(SEED) +verilator+rand+reset+2

# Sobel is elastic: the same input with and without output stalls must give
# the same output.
tb_proc:
	$(call build,$@,tb_proc,tb_proc,)
	$(call build,$@_rnd,tb_proc,tb_proc,-GRND=1)
	@a=$$($(OBJ)/$@/Vtb_proc | grep hash); b=$$($(OBJ)/$@_rnd/Vtb_proc | grep hash); \
	  if [ "$$a" = "$$b" ]; then echo "PASS tb_proc ($$a)"; else echo "FAIL tb_proc: $$a vs $$b"; exit 1; fi

# Processing engine (Sobel) shown right of an unaligned split column, and
# (invert)
# the edge case of a split at column 0 (layer 0 not read at all).
tb_disp_split:
	$(call build,$@,tb_disp,tb_disp,-GPROC=1 -GSPLIT=643 -GPMODE=2)
	$(OBJ)/$@/Vtb_disp +verilator+seed+$(SEED) +verilator+rand+reset+2
tb_disp_split0:
	$(call build,$@,tb_disp,tb_disp,-GPROC=1 -GSPLIT=0)
	$(OBJ)/$@/Vtb_disp +verilator+seed+$(SEED) +verilator+rand+reset+2

# A DDR controller that does not echo AXI IDs (the board's may not).
tb_vidsub_badid:
	$(call build,$@,tb_vidsub,tb_vidsub,-GBAD_IDS=1)
	$(OBJ)/$@/Vtb_vidsub +verilator+seed+$(SEED) +verilator+rand+reset+2

# The checkers must fire: a source that withdraws beats has to fail.
sva_neg:
	$(call build,$@,tb_fifo,tb_fifo,-GMISBEHAVE=1)
	@if $(OBJ)/$@/Vtb_fifo > $(OBJ)/$@/run.log 2>&1; then \
	  echo "FAIL sva_neg: misbehaving source was not caught"; exit 1; \
	else grep -m1 "withdrawn before transfer" $(OBJ)/$@/run.log && echo "PASS sva_neg"; fi

# Camera path against the bit-exact reference model (sim/ref/isp_ref.py).
# Run from the repository root: the gamma table path is relative to it.
REF := python3 $(ROOT)/sim/ref/isp_ref.py
tb_isp:
	$(call build,$@,tb_isp,tb_isp,)
	$(REF) gen-raw $(OBJ)/$@/raw.hex --seed $(SEED)
	cd $(ROOT) && $(OBJ)/$@/Vtb_isp +verilator+seed+$(SEED) +verilator+rand+reset+2
	$(REF) check $(OBJ)/$@/raw.hex $(OBJ)/$@/dump.hex

tb_isp_bypass:
	$(call build,$@,tb_isp,tb_isp,-GBYPASS=1 -GRAW='"sim/obj/$@/raw.hex"' -GDUMP='"sim/obj/$@/dump.hex"')
	$(REF) gen-raw $(OBJ)/$@/raw.hex --seed $(SEED)
	cd $(ROOT) && $(OBJ)/$@/Vtb_isp +verilator+seed+$(SEED) +verilator+rand+reset+2
	$(REF) check --bypass $(OBJ)/$@/raw.hex $(OBJ)/$@/dump.hex

# csi_capture's own picture: the signature printed here is what the board
# must report with CSI_PATTERN = 1.
tb_isp_pat:
	$(call build,$@,tb_isp,tb_isp,-GPATTERN=1 -GDUMP='"sim/obj/$@/dump.hex"')
	cd $(ROOT) && $(OBJ)/$@/Vtb_isp +verilator+seed+$(SEED) +verilator+rand+reset+2
	$(REF) check pattern $(OBJ)/$@/dump.hex
